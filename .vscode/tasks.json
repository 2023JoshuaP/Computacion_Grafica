{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile OpenGL",
            "type": "shell",
            "command": "g++",
            "args": [
                "-g",
                "-std=c++17",
                "${file}",
                "Unidad 3/src/glad.c",
                "-IUnidad 3/include",
                "-LUnidad 3/lib",
                "-lglfw3dll",
                "-lopengl32",
                "-lgdi32",
                "-o",
                "Unidad 3/${input:exeName}.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        }
    ],
    "inputs": [
        {
            "id": "exeName",
            "type": "promptString",
            "description": "Enter the name for the executable file (without extension)",
            "default": "output"
        }
    ]
}